{
    "name": "simplemvc/simplemvc",
    "description": "A compact PHP MVC framework without runtime dependencies",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "controller\\": "controller/",
            "logic\\": "logic/",
            "model\\": "model/",
            "mvcsystem\\": "mvcsystem/"
        },
        "files": [
            "mvcsystem/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
